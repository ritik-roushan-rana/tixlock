# Dependencies
node_modules/

# Secrets — never commit a real env file. Only .env.example belongs in the repo.
.env
.env.local
.env.*.local
# Explicit negation so the documented template survives any broadening of the rules
# above. Both backend/.env.example and frontend/.env.example are required by a clone.
!.env.example

# Build output
dist/
dist-ssr/
build/
.vite/

# Generated screenshots from the E2E design audit (scripts/e2e/*.mjs)
_shots/

# Scratch scripts written during local investigation — measurement harnesses,
# screenshot drivers, one-off probes. Everything worth keeping lives under
# scripts/, so an underscore prefix is the convention for "throwaway".
_*.mjs

# Temporary files
*.tmp
*.temp

# Database dumps and local database files
*.sql.gz
*.dump
*.dumpfile
*.bak
pgdata/
*.sqlite
*.sqlite3
*.db

# Test and coverage output
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp
