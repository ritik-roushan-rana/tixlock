# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database — a single standard Postgres connection string.
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local (Homebrew Postgres, trust auth, no password):
#   postgresql://localhost:5432/ticket_booking
# Local with a password:
#   postgresql://postgres:postgres@localhost:5432/ticket_booking
#
# Render / Railway: attaching their managed Postgres add-on injects DATABASE_URL
# automatically. Leave this unset in the dashboard and let the platform provide
# it — do not paste a hardcoded host/user/password.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/ticket_booking

# Used only by `npm test`, so a test run can never touch the dev database.
TEST_DATABASE_URL=postgresql://localhost:5432/ticket_booking_test

# TLS is auto-enabled for non-local hosts and disabled for localhost.
# Override only if that detection is wrong for your setup: true | false
# PGSSL=

# Connection pool. Keep max modest on free tiers — Render's starter Postgres
# allows a low total connection count across all clients.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Required in production — boot fails without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# Seat lifecycle windows
# ---------------------------------------------------------------------------
# How long a customer's seat selection is held before the sweeper frees it.
HOLD_TTL_MINUTES=10
# How long a waitlist offer stays claimable before cascading to the next person.
OFFER_TTL_MINUTES=30
# Sweep schedule (6-field cron with seconds). Default: every 15 seconds.
SWEEP_CRON=*/15 * * * * *
# Set to false to disable the background sweeper (useful when running a
# second instance that should not also sweep).
SWEEP_ENABLED=true

# ---------------------------------------------------------------------------
# Email. Three delivery paths, chosen in this order:
#
#   1. BREVO_API_KEY set  -> Brevo's HTTPS transactional API (port 443)
#   2. SMTP_HOST set      -> plain SMTP
#   3. neither            -> console transport; mail is logged, not sent
#
# Prefer the HTTPS API when deploying to Railway: Railway blocks outbound SMTP
# on Free/Trial/Hobby plans, so ports 25/465/587/2525 all time out there and no
# SMTP configuration can deliver. Get a key from Brevo -> SMTP & API -> API Keys
# (it starts with "xkeysib-"; this is NOT the same as your SMTP password, which
# starts with "xsmtpsib-").
#
# Note: Brevo does not support CID/embedded images on transactional email, so the
# booking QR code arrives as a .png attachment rather than inline.
# ---------------------------------------------------------------------------
BREVO_API_KEY=

# ---------------------------------------------------------------------------
# SMTP fallback, used only when BREVO_API_KEY is empty. Mailtrap works well for
# local development: https://mailtrap.io -> Inboxes -> SMTP Settings
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TixLock <no-reply@ticketbooking.local>

# Absolute base URL used to build waitlist offer links in emails.
# In production set this to your deployed URL, e.g. https://myapp.onrender.com
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seeded admin account (admins are never self-registered via the API).
# Change the password before deploying anywhere public.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@ticketbooking.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Platform Admin
