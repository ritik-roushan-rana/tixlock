# ---------------------------------------------------------------------------
# Frontend configuration. Copy to .env.local for local development.
#
# Only VITE_-prefixed variables are exposed to the browser by Vite. Everything
# here ends up in the built bundle, so never put a secret in this file.
# ---------------------------------------------------------------------------

# Backend origin — no trailing slash, no /api suffix (the client appends /api).
#
#   local development : leave blank to use the Vite dev proxy on :5173,
#                       or set http://localhost:3000 to call the API directly
#   production        : https://your-backend.onrender.com
#
# Leaving this blank makes all requests relative to the current origin, which is
# what you want when the backend serves the built frontend itself.
VITE_API_URL=http://localhost:3000

# Socket.io origin. Defaults to VITE_API_URL when omitted, which is correct
# whenever the backend serves both the API and the websocket — it does here.
# Set it only if you terminate websockets somewhere else.
VITE_SOCKET_URL=http://localhost:3000
