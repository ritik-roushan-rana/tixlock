node_modules/
dist/
dist-ssr/
# Throwaway build output and Playwright scratch scripts from local UI
# verification. They are regenerated on demand and mean nothing to a clone.
dist-verify/
_shot_*.mjs
_dbg_*.mjs
*.local
.env
.env.local
.env.*.local
.vite/
.DS_Store
*.log
.vercel
.env*
# .env.example documents every variable and must stay in the repo. Without this
# negation the broad .env* rule above silently swallows it the moment it is not
# already tracked (e.g. after a re-add), which is how a fresh clone loses its
# configuration reference.
!.env.example
