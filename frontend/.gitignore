node_modules/
dist/
dist-ssr/
# Throwaway build output and scratch scripts from local UI verification. They are
# regenerated on demand and mean nothing to a clone. The underscore prefix is the
# repo's convention for a throwaway script; real tooling lives under scripts/.
dist-verify/
_*.mjs
*.local
.env
.env.local
.env.*.local
.vite/
.DS_Store
*.log
.vercel
.env*
# .env.example documents every variable and must stay in the repo. Without this
# negation the broad .env* rule above silently swallows it the moment it is not
# already tracked (e.g. after a re-add), which is how a fresh clone loses its
# configuration reference.
!.env.example
